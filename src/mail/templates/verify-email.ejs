<div
  style="
    font-family: &quot;Courier New&quot;, Courier, monospace;
    padding: 20px;
    border-radius: 8px;
    background-color: hsl(0, 0%, 96%);
  "
>
  <h2 style="color: rgb(22, 22, 22)">Verify your email address!</h2>

  <p>Click on the link below to verify your email address.</p>

  <a
    href="<%= link %>"
    style="
      text-decoration: solid;
      display: inline-block;
      margin: 20px 0;
      color: rgb(49, 66, 198);
      background-color: rgb(184, 184, 184);
      padding: 10px;
      border-radius: 5px;
      text-decoration-line: solid underline;
    "
    >Verify</a
  >

  Thanks
</div>
